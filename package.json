{
  "name": "jibli.tn-code",
  "version": "1.0.0",
  "description": "**Jibli.tn** est une plateforme communautaire connectant des voyageurs disposant d'espace libre dans leurs bagages avec des personnes souhaitant envoyer des colis (documents, médicaments, électronique, vêtements, etc.) vers une destination spécifique (ex: Paris → Tunis).",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm test && npm run test:e2e",
    "seed": "node backend/seed.js",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/output.css"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/jest": "^30.0.0",
    "autoprefixer": "^10.4.23",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19"
  }
}